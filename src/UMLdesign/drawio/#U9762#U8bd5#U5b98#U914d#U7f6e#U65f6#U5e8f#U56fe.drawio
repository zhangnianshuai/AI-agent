<mxfile host="Electron">
  <diagram name="第 1 页" id="kILCJXFHwGTobt-omMD5">
    <mxGraphModel dx="1548" dy="1117" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n    participant Enterprise as 企业操作端\n    participant Frontend as 前端页面\n    participant Backend as 后端服务\n    participant MySQL as MySQL数据库\n\n    Note over Enterprise,MySQL: 企业查询岗位列表+编辑岗位+配置AI面试官Agent流程\n\n    %% 1.企业请求岗位列表\n    Enterprise-&gt;&gt;Frontend: 点击【获取公司岗位列表】\n    %% 2.前端携带cookie中的user_id请求后端\n    Frontend-&gt;&gt;Backend: 请求岗位列表，携带cookie内user_id\n    %% 3.后端多表联查获取岗位数据\n    Backend-&gt;&gt;MySQL: 根据user_id查询user-company表，获取company_id列表\n    MySQL--&gt;&gt;Backend: 返回关联公司ID集合\n    Backend-&gt;&gt;MySQL: 根据company_id查询company-work、work表，查询全部岗位\n    MySQL--&gt;&gt;Backend: 返回所属公司所有岗位列表\n    %% 4.返回列表，企业选中岗位进入编辑\n    Backend--&gt;&gt;Frontend: 返回岗位列表数据\n    Frontend--&gt;&gt;Enterprise: 渲染展示岗位列表\n    Enterprise-&gt;&gt;Frontend: 选中目标岗位，点击【编辑】\n    %% 5.根据岗位ID查询详情\n    Frontend-&gt;&gt;Backend: 根据work_id请求岗位详细信息\n    Backend-&gt;&gt;MySQL: 通过work_id查询岗位完整详情\n    MySQL--&gt;&gt;Backend: 返回岗位详情数据\n    Backend--&gt;&gt;Frontend: 返回岗位详情\n    Frontend--&gt;&gt;Enterprise: 展示岗位编辑页面\n    %% 6.进入面试官配置模块\n    Enterprise-&gt;&gt;Frontend: 点击【配置面试官】\n    %% 7.输入Agent配置参数\n    Enterprise-&gt;&gt;Frontend: 输入配置参数(ranker_params、score_threshold、question_nums)\n    %% 8.参数提交后端入库\n    Frontend-&gt;&gt;Backend: 提交{岗位work_id + Agent配置参数}\n    Backend-&gt;&gt;MySQL: 将配置信息写入agent-config表\n    MySQL--&gt;&gt;Backend: 返回存储成功响应\n    Backend--&gt;&gt;Frontend: 返回配置保存成功提示\n    Frontend--&gt;&gt;Enterprise: 提示面试官配置保存完成&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="9YD_MUqx_P8JeapgtAJ2-1">
          <mxCell connectable="0" parent="1" style="group;transparentBounds=1;editIcon=1;lockedGroup=0;groupPadding=20;" vertex="1">
            <mxGeometry as="geometry" />
          </mxCell>
        </UserObject>
